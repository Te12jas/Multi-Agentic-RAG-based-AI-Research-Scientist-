# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=

# Model Configuration
FAST_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
REASONING_MODEL=openai/gpt-oss-120b

# Development Mode (set to true to show monitoring dashboard)
DEV_MODE=false

# arXiv Search Configuration
DEFAULT_PAPERS_K=5
DEFAULT_CHUNKS_TOP_N=10

# Logging
LOG_LEVEL=INFO

# ============================================
# SUPABASE CONFIGURATION (Optional - for cloud deployment)
# ============================================
# If both SUPABASE_URL and SUPABASE_KEY are set, the monitoring
# system will use Supabase instead of SQLite for persistent storage.
# This is recommended for Streamlit Cloud or other ephemeral deployments.
#
# Get your free Supabase credentials at: https://supabase.com
#
# IMPORTANT: You must create the query_logs table in Supabase first.
# Run this SQL in the Supabase SQL Editor:
#
# CREATE TABLE query_logs (
#     id SERIAL PRIMARY KEY,
#     query_id TEXT UNIQUE,
#     timestamp TIMESTAMPTZ DEFAULT NOW(),
#     query_text TEXT,
#     papers_fetched INTEGER,
#     chunks_indexed INTEGER,
#     chunks_retrieved INTEGER,
#     retrieval_latency_ms FLOAT,
#     total_latency_ms FLOAT,
#     groq_tokens_used INTEGER,
#     agent_calls JSONB,
#     hallucination_flag BOOLEAN,
#     success BOOLEAN,
#     error_message TEXT
# );
#
# Then enable Row Level Security and create policies as needed.

SUPABASE_URL=
SUPABASE_KEY=
